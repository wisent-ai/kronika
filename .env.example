# The Brama address this machine dials. When unset, the site pipeline asks Stado
# (`stado capabilities resolve inference --consumer kronika`) for the alternative that answers.
BRAMA_URL=
BRAMA_API_KEY_ROLE=
# Optional request signing; set both or neither:
WISENT_APP_AGENT_ID=
WISENT_APP_AGENT_AUTH_SECRET_ROLE=
KRONIKA_MODEL=any
