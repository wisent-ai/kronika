# A router to ask, optional. Left unset, every Kronika model request (CLI and
# site pipeline) is handed to `stado capabilities call inference --consumer
# kronika`, which asks the first alternative in Stado's selected order that
# answers it; no bearer is read then. Set, BRAMA_API_KEY_ROLE names its bearer.
BRAMA_URL=
BRAMA_API_KEY_ROLE=
# Optional request signing; set both or neither:
WISENT_APP_AGENT_ID=
WISENT_APP_AGENT_AUTH_SECRET_ROLE=
KRONIKA_MODEL=any
