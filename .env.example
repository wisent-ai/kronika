# The Brama address this machine dials; Stado's service directory publishes it
# to ~/.stado/forwards/brama.local, which the site pipeline reads when this is unset.
BRAMA_URL=
BRAMA_API_KEY_ROLE=
# Optional request signing; set both or neither:
WISENT_APP_AGENT_ID=
WISENT_APP_AGENT_AUTH_SECRET_ROLE=
KRONIKA_MODEL=any
