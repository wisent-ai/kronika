{
  "name": "@wisent-ai/kronika",
  "version": "0.1.0",
  "private": true,
  "description": "Source-grounded documentation writer backed by Brama",
  "type": "module",
  "bin": {
    "kronika": "dist/src/cli.js"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "smoke": "npm run build && node dist/src/cli.js sources --repo . --source src"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3"
  }
}
