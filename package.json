{
  "name": "@wisent-ai/kronika",
  "version": "0.2.0",
  "private": false,
  "description": "Source-grounded documentation writer and documentation-site pipeline backed by Brama",
  "license": "SEE LICENSE IN LICENSE",
  "repository": "https://github.com/wisent-ai/kronika",
  "type": "module",
  "bin": {
    "kronika": "dist/src/cli.js",
    "kronika-site": "pipeline/src/run.mjs"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "files": [
    "dist",
    "gui",
    "pipeline",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "docs:detect": "node pipeline/src/stages/detect.mjs",
    "docs:validate": "node pipeline/src/stages/validate.mjs",
    "docs:emit": "node pipeline/src/stages/emit.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3"
  }
}
