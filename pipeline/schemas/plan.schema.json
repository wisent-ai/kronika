{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wisent.com/schemas/docs-plan.v1.json",
  "title": "Documentation content plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["product", "version", "sources", "terms", "pages"],
  "properties": {
    "product": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1, "description": "Exact product version the claims were verified against" },
    "sources": {
      "type": "object",
      "description": "Named source registry; every claim pointer names one of these",
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "location"],
        "properties": {
          "kind": { "enum": ["file", "command", "url"] },
          "location": { "type": "string" }
        }
      }
    },
    "terms": {
      "type": "array",
      "description": "Every recurring concept term with the page slug that defines it",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["term", "definedOn"],
        "properties": { "term": { "type": "string" }, "definedOn": { "type": "string" } }
      }
    },
    "pages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["slug", "nav", "kind", "title", "description", "sections"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "nav": { "type": "string" },
          "group": { "type": "string", "description": "Optional sidebar group label" },
          "kind": { "enum": ["overview", "quick-start", "task-guide", "examples", "concept", "cli-reference", "api-reference", "config-reference", "sdk-reference", "changelog", "migration", "versions", "troubleshooting", "security", "limits", "support", "faq", "definitions", "contributing"] },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "sections": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["title", "blocks"],
              "properties": {
                "title": { "type": "string" },
                "blocks": {
                  "type": "array", "minItems": 1,
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["type", "claim"],
                    "properties": {
                      "type": { "enum": ["paragraph", "bullets", "steps", "code", "table", "callout"] },
                      "claim": {
                        "type": "object", "additionalProperties": false,
                        "required": ["source", "evidence"],
                        "properties": {
                          "source": { "type": "string", "description": "Key into plan.sources" },
                          "evidence": { "type": "string", "minLength": 3, "description": "Verbatim substring or regex that MUST occur in the source" },
                          "evidenceIsRegex": { "type": "boolean", "default": false }
                        }
                      },
                      "text": { "type": "string" },
                      "items": { "type": "array", "items": { "type": "string" } },
                      "code": { "type": "object", "additionalProperties": false, "required": ["code"], "properties": { "label": { "type": "string" }, "code": { "type": "string" } } },
                      "table": { "type": "object", "additionalProperties": false, "required": ["columns", "rows"], "properties": { "caption": { "type": "string" }, "columns": { "type": "array", "items": { "type": "string" } }, "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } } } },
                      "callout": { "type": "object", "additionalProperties": false, "required": ["text"], "properties": { "title": { "type": "string" }, "text": { "type": "string" }, "tone": { "enum": ["note", "tip"] } } }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
